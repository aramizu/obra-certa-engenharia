# Database (Configurado automaticamente via Neon Integration no Vercel)
DATABASE_URL=postgresql://user:password@host/database
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database

# Auth (DEVE SER CONFIGURADO MANUALMENTE NO VERCEL)
# Gerar com: openssl rand -base64 48
AUTH_SECRET=your-secret-key-here-min-32-chars

# Node Environment
NODE_ENV=production
