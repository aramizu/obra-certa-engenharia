{
  "framework": "nextjs",
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "minha-engenharia.vercel.app" }],
      "destination": "https://obra-certa-engenharia.vercel.app/:path*",
      "permanent": true
    }
  ],
  "crons": [
    { "path": "/api/cron/vencimentos?h=00", "schedule": "0 0 * * *" },
    { "path": "/api/cron/vencimentos?h=01", "schedule": "0 1 * * *" },
    { "path": "/api/cron/vencimentos?h=02", "schedule": "0 2 * * *" },
    { "path": "/api/cron/vencimentos?h=03", "schedule": "0 3 * * *" },
    { "path": "/api/cron/vencimentos?h=04", "schedule": "0 4 * * *" },
    { "path": "/api/cron/vencimentos?h=05", "schedule": "0 5 * * *" },
    { "path": "/api/cron/vencimentos?h=06", "schedule": "0 6 * * *" },
    { "path": "/api/cron/vencimentos?h=07", "schedule": "0 7 * * *" },
    { "path": "/api/cron/vencimentos?h=08", "schedule": "0 8 * * *" },
    { "path": "/api/cron/vencimentos?h=09", "schedule": "0 9 * * *" },
    { "path": "/api/cron/vencimentos?h=10", "schedule": "0 10 * * *" },
    { "path": "/api/cron/vencimentos?h=11", "schedule": "0 11 * * *" },
    { "path": "/api/cron/vencimentos?h=12", "schedule": "0 12 * * *" },
    { "path": "/api/cron/vencimentos?h=13", "schedule": "0 13 * * *" },
    { "path": "/api/cron/vencimentos?h=14", "schedule": "0 14 * * *" },
    { "path": "/api/cron/vencimentos?h=15", "schedule": "0 15 * * *" },
    { "path": "/api/cron/vencimentos?h=16", "schedule": "0 16 * * *" },
    { "path": "/api/cron/vencimentos?h=17", "schedule": "0 17 * * *" },
    { "path": "/api/cron/vencimentos?h=18", "schedule": "0 18 * * *" },
    { "path": "/api/cron/vencimentos?h=19", "schedule": "0 19 * * *" },
    { "path": "/api/cron/vencimentos?h=20", "schedule": "0 20 * * *" },
    { "path": "/api/cron/vencimentos?h=21", "schedule": "0 21 * * *" },
    { "path": "/api/cron/vencimentos?h=22", "schedule": "0 22 * * *" },
    { "path": "/api/cron/vencimentos?h=23", "schedule": "0 23 * * *" }
  ]
}
