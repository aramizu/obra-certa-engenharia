{
  "framework": "nextjs",
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "minha-engenharia.vercel.app" }],
      "destination": "https://obra-certa-engenharia.vercel.app/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/vencimentos",
      "schedule": "0 * * * *"
    }
  ]
}
